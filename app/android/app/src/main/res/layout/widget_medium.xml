<?xml version="1.0" encoding="utf-8"?>
<!-- Medium widget (4×2): ring left, details right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_light"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <FrameLayout
        android:id="@+id/w_ring_box"
        android:layout_width="104dp"
        android:layout_height="104dp">
        <ProgressBar
            android:id="@+id/w_ring_track"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:max="100"
            android:progress="100"
            android:progressTint="#2E7C5CD6"
            android:progressDrawable="@drawable/widget_circle_progress" />

        <ProgressBar
            android:id="@+id/w_ring"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:max="28"
            android:progress="0"
            android:progressTint="#FF7C5CD6"
            android:progressDrawable="@drawable/widget_circle_progress" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/w_big"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="–"
                android:textColor="#FF1C1B1F"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#FF6B6870"
                android:textSize="11sp" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/w_head"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text=""
            android:textColor="#FF1C1B1F"
            android:textSize="15sp" android:textStyle="bold" />
        <TextView
            android:id="@+id/w_line1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text=""
            android:textColor="#FF6B6870"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/w_line2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text=""
            android:textColor="#FF6B6870"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/w_line3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text=""
            android:textColor="#FF6B6870"
            android:textSize="13sp" />
    </LinearLayout>

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/w_quick"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_alignParentTop="true"
        android:background="@drawable/widget_quick_button">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="+"
            android:src="@drawable/ic_widget_add" />
    </FrameLayout>
    </RelativeLayout>
</LinearLayout>
